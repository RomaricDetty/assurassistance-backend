{
	"info": {
		"_postman_id": "assurassistance-admin-collection",
		"name": "Assur'Assistance - API Administrateurs",
		"description": "Collection Postman pour les endpoints Administrateur de l'API Assur'Assistance.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "administrateurId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.collectionVariables.set('token', json.data.token);",
									"        if (json.data.administrateur && json.data.administrateur.id) {",
									"            pm.collectionVariables.set('administrateurId', json.data.administrateur.id);",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"assurassistance_user\",\n    \"password\": \"M@nagement_123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/administrateurs/login",
							"host": ["{{baseUrl}}"],
							"path": ["administrateurs", "login"]
						},
						"description": "Authentification. Retourne un token JWT. Le token est enregistré automatiquement dans la variable de collection pour les requêtes protégées."
					}
				}
			]
		},
		{
			"name": "Créer un administrateur",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"login\": \"new_admin\",\n    \"password\": \"Secure@123\",\n    \"nom\": \"Dupont\",\n    \"prenom\": \"Jean\",\n    \"email\": \"jean.dupont@example.com\",\n    \"isActive\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/administrateurs",
					"host": ["{{baseUrl}}"],
					"path": ["administrateurs"]
				},
				"description": "Créer un nouvel administrateur. Requiert un token Bearer (exécuter Login d'abord)."
			}
		},
		{
			"name": "Liste des administrateurs",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/administrateurs?isActive=true",
					"host": ["{{baseUrl}}"],
					"path": ["administrateurs"],
					"query": [
						{
							"key": "isActive",
							"value": "true",
							"description": "Filtrer par statut (true/false). Optionnel."
						}
					]
				},
				"description": "Récupérer tous les administrateurs. Paramètre optionnel : isActive (boolean)."
			}
		},
		{
			"name": "Détail d'un administrateur",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/administrateurs/{{administrateurId}}",
					"host": ["{{baseUrl}}"],
					"path": ["administrateurs", "{{administrateurId}}"]
				},
				"description": "Récupérer un administrateur par son ID (UUID). administrateurId est mis à jour après Login."
			}
		},
		{
			"name": "Modifier un administrateur",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nom\": \"Dupont\",\n    \"prenom\": \"Jean-Pierre\",\n    \"email\": \"jean.dupont@example.com\",\n    \"isActive\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/administrateurs/{{administrateurId}}",
					"host": ["{{baseUrl}}"],
					"path": ["administrateurs", "{{administrateurId}}"]
				},
				"description": "Mettre à jour un administrateur. Tous les champs du body sont optionnels (login, password, nom, prenom, email, isActive)."
			}
		}
	]
}
