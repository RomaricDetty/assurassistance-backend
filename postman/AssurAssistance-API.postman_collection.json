{
	"info": {
		"_postman_id": "assurassistance-api-collection",
		"name": "Assur'Assistance - API",
		"description": "Collection Postman complète pour l'API Assur'Assistance (Administrateurs, Clients, Health). Exécuter **Login** en premier pour enregistrer le token.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "administrateurId",
			"value": ""
		},
		{
			"key": "clientId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.collectionVariables.set('token', json.data.token);",
									"        if (json.data.administrateur && json.data.administrateur.id) {",
									"            pm.collectionVariables.set('administrateurId', json.data.administrateur.id);",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"assurassistance_user\",\n    \"password\": \"M@nagement_123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/administrateurs/login", "host": ["{{baseUrl}}"], "path": ["administrateurs", "login"] },
						"description": "Authentification. Retourne un JWT. Le token et l'id administrateur sont enregistrés automatiquement pour les requêtes protégées."
					}
				}
			]
		},
		{
			"name": "Health",
			"item": [
				{
					"name": "Health check",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/health-check", "host": ["{{baseUrl}}"], "path": ["health-check"] },
						"description": "Vérifier que l'API est opérationnelle. Pas d'authentification."
					}
				}
			]
		},
		{
			"name": "Administrateurs",
			"item": [
				{
					"name": "Profil connecté (me)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/administrateurs/me", "host": ["{{baseUrl}}"], "path": ["administrateurs", "me"] },
						"description": "Récupérer le profil de l'administrateur connecté via le token uniquement."
					}
				},
				{
					"name": "Créer un administrateur",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"new_admin\",\n    \"password\": \"Secure@123\",\n    \"nom\": \"Dupont\",\n    \"prenom\": \"Jean\",\n    \"email\": \"jean.dupont@example.com\",\n    \"isActive\": true\n}"
						},
						"url": { "raw": "{{baseUrl}}/administrateurs", "host": ["{{baseUrl}}"], "path": ["administrateurs"] },
						"description": "Créer un nouvel administrateur."
					}
				},
				{
					"name": "Liste des administrateurs",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/administrateurs?page=1&limit=10&isActive=true",
							"host": ["{{baseUrl}}"],
							"path": ["administrateurs"],
							"query": [
								{ "key": "page", "value": "1", "description": "Numéro de page (défaut 1)" },
								{ "key": "limit", "value": "10", "description": "Éléments par page (défaut 10, max 100)" },
								{ "key": "isActive", "value": "true", "description": "Optionnel : filtrer par statut" }
							]
						},
						"description": "Récupérer les administrateurs (paginé). Réponse : data + meta (page, limit, total, totalPages)."
					}
				},
				{
					"name": "Détail d'un administrateur",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/administrateurs/{{administrateurId}}", "host": ["{{baseUrl}}"], "path": ["administrateurs", "{{administrateurId}}"] },
						"description": "Récupérer un administrateur par ID (UUID). administrateurId est défini après Login."
					}
				},
				{
					"name": "Modifier un administrateur",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nom\": \"Dupont\",\n    \"prenom\": \"Jean-Pierre\",\n    \"email\": \"jean.dupont@example.com\",\n    \"isActive\": true\n}"
						},
						"url": { "raw": "{{baseUrl}}/administrateurs/{{administrateurId}}", "host": ["{{baseUrl}}"], "path": ["administrateurs", "{{administrateurId}}"] },
						"description": "Mettre à jour un administrateur. Champs optionnels : login, password, nom, prenom, email, isActive."
					}
				}
			]
		},
		{
			"name": "Clients",
			"item": [
				{
					"name": "Créer un client",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    if (json.data && json.data.id) {",
									"        pm.collectionVariables.set('clientId', json.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nomClient\": \"Dupont\",\n    \"prenomClient\": \"Jean\",\n    \"idCarteBancaire\": \"1234567890123456\",\n    \"typeContrat\": \"Business\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] },
						"description": "Créer un client. typeContrat : Business, Platinum ou Premier. clientId est enregistré automatiquement après création."
					}
				},
				{
					"name": "Liste des clients",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/clients?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["clients"],
							"query": [
								{ "key": "page", "value": "1", "description": "Numéro de page (défaut 1)" },
								{ "key": "limit", "value": "10", "description": "Éléments par page (défaut 10, max 100)" }
							]
						},
						"description": "Récupérer les clients (paginé). Réponse : data + meta (page, limit, total, totalPages)."
					}
				},
				{
					"name": "Détail d'un client",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] },
						"description": "Récupérer un client par ID (UUID). clientId est défini après Créer un client."
					}
				},
				{
					"name": "Modifier un client",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nomClient\": \"Martin\",\n    \"prenomClient\": \"Marie\",\n    \"typeContrat\": \"Platinum\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] },
						"description": "Mettre à jour un client. Tous les champs sont optionnels ; seules les valeurs différentes sont modifiées. typeContrat : Business, Platinum, Premier."
					}
				},
				{
					"name": "Supprimer un client",
					"request": {
						"method": "DELETE",
						"url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] },
						"description": "Supprimer un client par ID."
					}
				}
			]
		}
	]
}
